<Window x:Class="WpfApp4.PatientCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        mc:Ignorable="d"
        Title="Карточка пациента" Height="500" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="ФИО:" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="FioBox" Width="400"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Дата рожд:" VerticalAlignment="Center" Width="120"/>
                <DatePicker x:Name="BirthDatePicker" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Отделение:" VerticalAlignment="Center" Width="120"/>
                <ComboBox x:Name="DepartmentCombo" Width="300"/>
            </StackPanel>
            <DataGrid Grid.Row="3" x:Name="RecordsGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding UsageDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Препарат" Width="150"/>
                    <DataGridTextColumn Header="Дозировка" Binding="{Binding Dosage}" Width="150"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Добавить препарат" Width="150" Margin="0,0,5,0" Click="AddRecord_Click"/>
                <Button Content="Удалить препарат" Width="150" Margin="0,0,5,0" Click="DeleteRecord_Click"/>
                <Button Content="Сохранить карточку" Width="150" Margin="0,0,5,0" Click="SavePatient_Click"/>
                <Button Content="Назад" Width="100" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
