<Window x:Class="WpfApp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        mc:Ignorable="d"
        Title="Система учета использование препаратов" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="Главное меню">
                <MenuItem Header="Начать ввод" Click="MenuStartInput_Click"/>
                <MenuItem Header="Список пациентов" Click="MenuPatientsList_Click"/>
                <MenuItem Header="Отчеты" Click="MenuReports_Click"/>
                <MenuItem Header="Справочники" Click="MenuReferences_Click"/>
                <MenuItem Header="Резервное копирование" Click="MenuBackup_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem> 
        </Menu>
        <TextBlock Grid.Row="1"
                   Text="Добро пожаловать в систему учета!"
                   FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="SteelBlue"/>
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="Готово. База данных подключена."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
