<Window x:Class="WpfApp4.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        mc:Ignorable="d"
        Title="Отчеты" Height="600" Width="900" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="С:" VerticalAlignment="Center"/>
                <DatePicker x:Name="FromPicker" Width="150" Margin="5,0"/>
                <TextBlock Text="По:" VerticalAlignment="Center"/>
                <DatePicker x:Name="ToPicker" Width="150" Margin="5,0"/>
                <Button Content="Применить" Width="100" Margin="5,0" Click="ApplyFilter_Click"/>
                <Button Content="Экспорт в Excel (CSV)" Width="170" Margin="15,0,0,0" Click="Export_Click"/>
            </StackPanel>
            <DataGrid Grid.Row="1" x:Name="ReportGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
            <StatusBar Grid.Row="2">
                <StatusBarItem>
                    <TextBlock x:Name="TotalText" Text="Итого: 0"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
