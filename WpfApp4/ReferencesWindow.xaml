<Window x:Class="WpfApp4.ReferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        mc:Ignorable="d"
        Title="Справочники" Height="500" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Отделения" Grid.Column="0" Margin="0,0,5,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="Добавить" Width="90" Margin="0,0,5,0" Click="AddDepatment_Click"/>
                        <Button Content="Удалить" Width="90" Click="DeleteDepartment_Click"/>
                    </StackPanel>
                    <ListBox x:Name="DepartmentsList"/>
                </DockPanel>
            </GroupBox>
            <GroupBox Header="Препараты" Grid.Column="1" Margin="5,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="Добавить" Width="90" Margin="0,0,5,0" Click="AddMedication_Click"/>
                        <Button Content="Удалить" Width="90" Click="DeleteMedication_Click"/>
                    </StackPanel>
                    <ListBox x:Name="MedicationsList"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
